# ---------------------------------------------------------------------------
#  MARK 2.0 Plus -- documentation build
#
#  make            build the report (default)
#  make report     same
#  make figures    re-render the CFG figures from the Graphviz sources
#  make publish    copy the finished PDF into ../pdf/
#  make clean      remove build artefacts
#
#  The report is a single self-contained .tex: preamble, macros and
#  bibliography all live in it, so pdflatex + biber is the whole toolchain.
#  Always run from this directory: the figure paths inside the source are
#  relative to it, which is also how Overleaf compiles.
# ---------------------------------------------------------------------------

DOC      := mark-2.0-plus-report
PDFLATEX := pdflatex -interaction=nonstopmode -file-line-error
BIBER    := biber
PDFDIR   := ../pdf

.PHONY: all report figures publish clean distclean help

all: report

# Four passes: the first writes the embedded .bib and the .aux, biber resolves
# the bibliography, and the last two settle the table of contents, the
# cross-references and cleveref.
report:
	@echo "==> $(DOC)"
	@$(PDFLATEX) $(DOC).tex
	@$(BIBER) $(DOC)
	@$(PDFLATEX) $(DOC).tex
	@$(PDFLATEX) $(DOC).tex

figures:
	@echo "==> re-rendering CFGs with Graphviz"
	@cd ../.. && python tools/render_cfg.py

publish: report
	@mkdir -p $(PDFDIR)
	@cp $(DOC).pdf $(PDFDIR)/$(DOC).pdf
	@echo "  $(PDFDIR)/$(DOC).pdf"

# $(DOC).bib is generated by filecontents, so it is an artefact too.
clean:
	@rm -f $(DOC).aux $(DOC).bbl $(DOC).bcf $(DOC).blg $(DOC).log \
	       $(DOC).out $(DOC).run.xml $(DOC).toc $(DOC).bib \
	       $(DOC).fdb_latexmk $(DOC).fls $(DOC).synctex.gz
	@echo "build artefacts removed"

distclean: clean
	@rm -f $(DOC).pdf $(PDFDIR)/$(DOC).pdf

help:
	@echo "targets: report figures publish clean distclean"
