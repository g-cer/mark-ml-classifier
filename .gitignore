# ---------------------------------------------------------------------------
# MARK 2.0 Plus — .gitignore
#
# NOTE: do NOT add blanket rules such as `*.csv` or `*.md`.
# Test fixtures, library dictionaries and documentation are versioned files;
# a global ignore forces `git add -f` and has already caused data loss in the
# past. Ignore *locations* that hold generated data, not file *extensions*.
# ---------------------------------------------------------------------------

# --- Generated pipeline data ---
io/repos/
io/output/
modules/cloner/log/
logs/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- Testing & coverage ---
.pytest_cache/
.coverage
.coverage.*
coverage.xml

# --- Radon reports used by tools/calcola_voto.py ---
mi.json
cc.json

# --- Virtual environments ---
.venv/
venv/
env/

# --- LaTeX build artefacts ---
# The report's .bib is generated by filecontents from the .tex itself, so it is
# an artefact. Named explicitly rather than as *.bib, per the note at the top.
docs/latex/mark-2.0-plus-report.bib
docs/latex/mark-2.0-plus-report.pdf
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc

# --- Editors / OS ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
